#!/bin/bash
# Enable a site configuration (like nginx a2ensite)

set -e

SITES_AVAILABLE="$(printenv DESTDIR || true)/etc/adq-pingora/sites-available"
SITES_ENABLED="$(printenv DESTDIR || true)/etc/adq-pingora/sites-enabled"

if [ -z "$1" ]; then
    echo "Usage: adq-ensite <site-name>"
    echo "Available sites:"
    ls -1 "$SITES_AVAILABLE" 2>/dev/null || echo "No sites available"
    exit 1
fi

SITE_NAME="$1"
case "$SITE_NAME" in
    .|..|*/*) echo "Invalid site name: $SITE_NAME" >&2; exit 1 ;;
esac
AVAILABLE_FILE="$SITES_AVAILABLE/$SITE_NAME"
ENABLED_FILE="$SITES_ENABLED/$SITE_NAME"

if [ ! -f "$AVAILABLE_FILE" ]; then
    echo "Error: Site '$SITE_NAME' not found in $SITES_AVAILABLE"
    exit 1
fi

if [ -L "$ENABLED_FILE" ]; then
    if [ ! "$ENABLED_FILE" -ef "$AVAILABLE_FILE" ]; then
        echo "Error: existing site link does not point to $AVAILABLE_FILE" >&2
        exit 1
    fi
    echo "Site '$SITE_NAME' is already enabled"
    exit 0
fi

# Create sites-enabled directory if it doesn't exist
mkdir -p "$SITES_ENABLED"

# Create symbolic link
ln -s "../sites-available/$SITE_NAME" "$ENABLED_FILE"

echo "Site '$SITE_NAME' enabled"
echo "To activate the new configuration, run:"
echo "  sudo -u adq-pingora adqp -t && sudo systemctl restart adq-pingora"