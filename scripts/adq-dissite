#!/bin/bash
# Disable a site configuration (like nginx a2dissite)

set -e

SITES_ENABLED="$(printenv DESTDIR || true)/etc/adq-pingora/sites-enabled"

if [ -z "$1" ]; then
    echo "Usage: adq-dissite <site-name>"
    echo "Enabled sites:"
    ls -1 "$SITES_ENABLED" 2>/dev/null || echo "No sites enabled"
    exit 1
fi

SITE_NAME="$1"
case "$SITE_NAME" in
    .|..|*/*) echo "Invalid site name: $SITE_NAME" >&2; exit 1 ;;
esac
ENABLED_FILE="$SITES_ENABLED/$SITE_NAME"

if [ ! -L "$ENABLED_FILE" ]; then
    echo "Site '$SITE_NAME' is not enabled"
    exit 0
fi

# Remove symbolic link
rm "$ENABLED_FILE"

echo "Site '$SITE_NAME' disabled"
echo "To activate the new configuration, run:"
echo "  sudo -u adq-pingora adqp -t && sudo systemctl restart adq-pingora"